#!/bin/bash
set -e

CHEZMOI="/home/linuxbrew/.linuxbrew/bin/chezmoi"

$CHEZMOI re-add

SOURCE_DIR=$($CHEZMOI source-path)
cd "$SOURCE_DIR"

if [ -n "$(git status --porcelain)" ]; then
    git add .
    git commit -m "Auto-update: $(date +'%Y-%m-%d %H:%M:%S')"
    git push
else
    echo "No changes to push."
fi