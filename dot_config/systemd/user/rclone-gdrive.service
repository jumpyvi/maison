[Unit]
Description=RClone Google Drive Mount
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/home/linuxbrew/.linuxbrew/bin/rclone mount gdrive: %h/.local/mnt/gdrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --dir-cache-time 1h \
  --poll-interval 15s \
  --log-file %h/.cache/rclone/gdrive.log \
  --log-level INFO
ExecStop=/usr/bin/fusermount -u %h/.local/mnt/gdrive
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
